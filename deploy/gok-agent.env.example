# GOK Agent Environment Configuration
# Copy this file to /etc/default/gok-agent and customize as needed
# The service file uses EnvironmentFile=-/etc/default/gok-agent
# The '-' prefix means the file is optional (won't fail if missing)

# REQUIRED: Path to the configuration YAML file
# This file contains device settings, battery configurations, schedules, etc.
# Example: /opt/gok/current/config.yml
# Example: /etc/gok/config.yml
# Example: /home/user/gok-pi/config.yml
GOK_CONF=/opt/gok/current/config.yml

# REQUIRED: Directory path for log file output
# Logs are written to: ${GOK_LOG_DIR}/gok-pi.log
# The directory must exist and be writable by the service user
# Example: /var/log/gok
# Example: /var/log/gok-agent
# Example: /home/user/gok-pi/logs
GOK_LOG_DIR=/var/log/gok

# OPTIONAL: Environment override for the config file
# This can override the 'env' field in config.yml
# Valid values: "local", "dev", or "prod"
# - local: human-readable console output (stdout)
# - dev: JSON format with debug level logging
# - prod: JSON format with info level logging (default)
# Note: This is read by cleanenv from the config file, but can be set here
# if you want to override the config.yml value at runtime
# ENV=prod

# OPTIONAL: Device name override
# This can override the 'device_name' field in config.yml
# DEVICE_NAME=My Battery Controller

# OPTIONAL: Metrics server configuration overrides
# These can override values in the metrics section of config.yml
# METRICS_ENABLED=true
# METRICS_BIND=0.0.0.0
# METRICS_PORT=5001

# OPTIONAL: Remote control configuration overrides
# These can override values in the remote_control section of config.yml
# REMOTE_CONTROL_ENABLED=true
# REMOTE_CONTROL_SERVER_URL=wss://control.example.com/api/agent
# REMOTE_CONTROL_SHARED_SECRET=your-shared-secret-here
# REMOTE_CONTROL_RECONNECT_INITIAL_SECONDS=5
# REMOTE_CONTROL_RECONNECT_MAX_SECONDS=60

# Note: The config file (config.yml) uses cleanenv which can read environment
# variables to override YAML values. Environment variable names follow the pattern:
# - Top-level fields: UPPERCASE field name (e.g., ENV, DEVICE_NAME)
# - Nested fields: UPPERCASE section name + underscore + field name
#   (e.g., METRICS_ENABLED, REMOTE_CONTROL_SERVER_URL)
# 
# However, for most use cases, it's recommended to:
# 1. Set GOK_CONF and GOK_LOG_DIR in this environment file
# 2. Configure other settings in the config.yml file itself
# 3. Only use environment variable overrides when you need runtime flexibility

