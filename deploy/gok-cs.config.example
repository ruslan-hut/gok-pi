# GOK Control Server configuration
# Copy to /etc/gok-cs/config.yml and adjust values

addr: ":8080"
secret: ""
static: "/opt/gok-pi/current/app"
agent_binary: ""
version_file: "VERSION"
config_store: "/var/lib/gok-cs/agent-configs.json"
session_db: "/var/lib/gok-cs/sessions.db"
log_file: "/var/log/gok-cs.log"

# UI basic auth (leave empty to disable)
ui_username: ""
ui_password: ""

# Brevo email reports (https://brevo.com). When enabled, the control server
# emails per-agent daily/weekly/monthly battery reports to recipients
# configured per-agent in the web UI.
# Provisioned in CI from GitHub secrets: GOK_BREVO_*.
email_provider:
  enabled: false
  api_key: ""
  sender_name: "GOK-Pi"
  sender_email: ""
email_state: "/var/lib/gok-cs/email-reports-state.json"
