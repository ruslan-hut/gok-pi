# GOK Agent Updater Environment Configuration
# Copy this file to /etc/default/gok-agent-updater and customize as needed
# The service file uses EnvironmentFile=-/etc/default/gok-agent-updater
# The '-' prefix means the file is optional (won't fail if missing)

# REQUIRED: URL pointing to the remote VERSION manifest file
# This file should contain the version string (e.g., "v1.2.3")
# Example: https://example.com/releases/latest/VERSION
# Example: https://github.com/user/repo/releases/latest/download/VERSION
GOK_UPDATE_VERSION_URL=https://example.com/releases/latest/VERSION

# OPTIONAL: URL pointing to the remote binary file
# If not set, defaults to the VERSION directory plus binary name
# Example: https://example.com/releases/latest/gok
# Example: https://github.com/user/repo/releases/latest/download/gok
# GOK_UPDATE_BINARY_URL=https://example.com/releases/latest/gok

# OPTIONAL: Directory containing the local gok binary and VERSION manifest
# Default: "." (current working directory)
# Example: /opt/gok/current
# Example: /usr/local/bin
GOK_UPDATE_AGENT_ROOT=/opt/gok/current

# OPTIONAL: Binary filename stored under the agent-root directory
# Default: "gok"
# Example: gok
# Example: gok-agent
GOK_UPDATE_BINARY_NAME=gok

# OPTIONAL: HTTP timeout for remote fetch operations
# Default: "30s"
# Accepts Go duration format: "30s", "1m", "2m30s", etc.
# Example: 30s
# Example: 1m
# Example: 2m30s
GOK_UPDATE_TIMEOUT=30s

# OPTIONAL: Logger environment setting
# Default: "prod"
# Valid values: "local", "dev", or "prod"
# - local: human-readable console output
# - dev: JSON format with debug level
# - prod: JSON format with info level
GOK_UPDATE_LOG_ENV=prod

# OPTIONAL: Directory for JSON log output when log-env is dev or prod
# Default: "/var/log/gok"
# Only used when GOK_UPDATE_LOG_ENV is "dev" or "prod"
# Example: /var/log/gok
# Example: /var/log/gok-agent
GOK_UPDATE_LOG_DIR=/var/log/gok

