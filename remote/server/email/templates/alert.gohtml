{{- /* gotype: gok-pi/remote/server/email.alertView */ -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{.Title}}</title>
</head>
<body style="margin:0;padding:24px;background:#f8fafc;font-family:-apple-system,BlinkMacSystemFont,Segoe UI,Roboto,sans-serif;color:#0f172a;">
<div style="max-width:560px;margin:0 auto;background:#ffffff;border:1px solid #e2e8f0;border-left:4px solid {{.Accent}};border-radius:8px;padding:24px;">

<h1 style="margin:0 0 4px 0;font-size:20px;">{{.Heading}}</h1>
<div style="color:#475569;font-size:13px;margin-bottom:20px;">{{.SubHeading}}</div>

<table style="width:100%;border-collapse:collapse;font-size:13px;margin-bottom:20px;">
<tr>
<td style="padding:8px 0;border-bottom:1px solid #f1f5f9;color:#64748b;">Device</td>
<td style="padding:8px 0;border-bottom:1px solid #f1f5f9;text-align:right;font-weight:600;">{{.DeviceName}}</td>
</tr>
<tr>
<td style="padding:8px 0;border-bottom:1px solid #f1f5f9;color:#64748b;">Agent ID</td>
<td style="padding:8px 0;border-bottom:1px solid #f1f5f9;text-align:right;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">{{.AgentID}}</td>
</tr>
<tr>
<td style="padding:8px 0;border-bottom:1px solid #f1f5f9;color:#64748b;">Last connected</td>
<td style="padding:8px 0;border-bottom:1px solid #f1f5f9;text-align:right;font-variant-numeric:tabular-nums;">{{.Since}}</td>
</tr>
<tr>
<td style="padding:8px 0;color:#64748b;">Offline for</td>
<td style="padding:8px 0;text-align:right;font-variant-numeric:tabular-nums;font-weight:600;">{{.Duration}}</td>
</tr>
</table>

<p style="margin:0;color:#64748b;font-size:12px;line-height:1.5;">{{.Note}}</p>

</div>
</body>
</html>
