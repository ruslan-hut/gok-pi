# GOK Control Server configuration
# Copy to /etc/gok-cs/config.yml and adjust values

addr: ":8080"
secret: ""
static: "/opt/gok-pi/current/app"
agent_binary: ""
version_file: "VERSION"
config_store: "/var/lib/gok-cs/agent-configs.json"
session_db: "/var/lib/gok-cs/sessions.db"
log_file: "/var/log/gok-cs.log"

# UI basic auth (leave empty to disable)
ui_username: ""
ui_password: ""

# Brevo email reports (https://brevo.com). When enabled, the control server
# emails per-agent daily/weekly/monthly battery reports to recipients
# configured per-agent in the web UI.
# Provisioned in CI from GitHub secrets: GOK_BREVO_*.
email_provider:
  enabled: false
  api_key: ""
  sender_name: "GOK-Pi"
  sender_email: ""
email_state: "/var/lib/gok-cs/email-reports-state.json"

# EV charger integration: evsys posts charging session events to
# /api/webhooks/evsys and the linked battery discharges for their duration.
# charger_token must match the "token" field of the gok-pi document in the evsys
# webhook_subscribers collection. Empty disables the endpoint entirely (404) —
# it does not fail open. See EVSYS_INTEGRATION.md.
# Provisioned in CI from the GitHub secret GOK_CHARGER_TOKEN.
charger_token: ""
charger_links: "/var/lib/gok-cs/charger-links.json"
charger_sessions: "/var/lib/gok-cs/charger-sessions.json"
